_chunk_id": 44, "src_doc": "nr-04", "src_section": "4.1", "question": "O que é que a empresa é obrigada a ter pra cuidar da gente no trabalho?", "facts": ["As empresas são obrigadas a constituir e manter os Serviços Especializados em Segurança e Medicina do Trabalho (SESMT).", "A finalidade do SESMT é promover a saúde e proteger a integridade do trabalhador.", "A obrigatoriedade se aplica a organizações com empregados regidos pela CLT."], "coverage": 1.0, "seed_tag": 0, "gen_model": "Qwen/Qwen3.8-27B-FP8", "created_utc": "2026-09-12T20:05:24.908282+00:00"}}
