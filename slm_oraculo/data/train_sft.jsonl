ormativo."}], "meta": {"src_chunk_id": 1855, "src_doc": "nr-32", "src_section": "Anexo Ii", "question": "Qual o risco biológico do HIV e do HTLV-1?", "facts": ["HIV é classificado no Grupo 3 de risco biológico", "HTLV-1 e HTLV-2 são classificados no Grupo 3 de risco biológico"], "coverage": 1.0, "seed_tag": 0, "gen_model": "Qwen/Qwen3.8-27B-FP8", "created_utc": "2026-09-12T20:09:51.658437+00:00"}}
