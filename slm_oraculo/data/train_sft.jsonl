rícolas\n\nPergunta do eletricista:\nQual a altura certa pra barra do guarda-corpo em cima de uma plataforma?"}, {"role": "assistant", "content": "A altura da barra superior do guarda-corpo deve ficar entre 1000 mm e 1100 mm. Essa exigência está prevista na Figura 5 do Anexo II da NR-31."}], "meta": {"src_chunk_id": 1764, "src_doc": "nr-31", "src_section": "Anexo Ii", "question": "Qual a altura certa pra barra do guarda-corpo em cima de uma plataforma?", "facts": ["A altura da barra superior deve ser de 1000 mm", "A altura da barra superior pode ser de até 1100 mm"], "coverage": 1.0, "seed_tag": 0, "gen_model": "Qwen/Qwen3.8-27B-FP8", "created_utc": "2026-09-12T20:14:35.213589+00:00"}}
