c_doc": "nr-09", "src_section": "Anexo Iii", "question": "Aquele, quanto pode ser a temperatura aí no calor pra quem já tá acostumado com o serviço?", "facts": ["Os limites de exposição ao calor para trabalhadores aclimatizados dependem do valor de M[W] (metabolismo).", "Para um valor de M de 100 W, o IBUTG máximo permitido é 33,7 °C.", "Para um valor de M de 186 W, o IBUTG máximo permitido é 30,6 °C.", "Para um valor de M de 346 W, o IBUTG máximo permitido é 27,5 °C."], "coverage": 1.0, "seed_tag": 1, "gen_model": "Qwen/Qwen3.8-27B-FP8", "created_utc": "2026-09-12T20:14:39.149608+00:00"}}
