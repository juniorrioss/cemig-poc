doc": "nr-05", "src_section": "5.9", "question": "Se o perigo da empresa mudar, a gente muda a quantidade de gente da comissão de segurança na hora ou só quando tiver eleição?", "facts": ["O ajuste no tamanho da equipe de segurança (CIPA) acontece na próxima eleição", "A alteração no grau de risco do estabelecimento é o gatilho para o redimensionamento", "O redimensionamento não é feito imediatamente, mas sim no ciclo eleitoral subsequente"], "coverage": 1.0, "seed_tag": 1, "gen_model": "Qwen/Qwen3.8-27B-FP8", "created_utc": "2026-09-12T20:02:58.377246+00:00"}}
