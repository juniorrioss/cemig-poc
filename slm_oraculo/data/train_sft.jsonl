le": "assistant", "content": "A cama deve possuir dimensões internas que comportem um colchão de solteiro de, no mínimo, 1,88 m x 0,78 m. Esse requisito está definido na NR-37, item 37.12.7.3, alínea a."}], "meta": {"src_chunk_id": 2108, "src_doc": "nr-37", "src_section": "37.12.7", "question": "Boa, qual o tamanho mínimo que a cama do camarote precisa ter pra caber o colchão?", "facts": ["A cama deve ter dimensões internas que comportem um colchão de solteiro de no mínimo 1,88 m x 0,78 m.", "A altura mínima da cama, medida da face superior do colchão ao piso, deve ser de 0,40 m."], "coverage": 0.5, "seed_tag": 0, "gen_model": "Qwen/Qwen3.8-27B-FP8", "created_utc": "2026-09-12T20:04:03.363339+00:00"}}
