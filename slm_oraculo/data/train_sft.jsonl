dores de segurança."}], "meta": {"src_chunk_id": 1635, "src_doc": "nr-30", "src_section": "30.20", "question": "Como a gente calcula a taxa de acidentes sem afastamento?", "facts": ["Multiplicar o número de acidentes sem afastamento por 1.000.000", "Dividir o resultado pelo número de horas-homem de exposição"], "coverage": 1.0, "seed_tag": 0, "gen_model": "Qwen/Qwen3.8-27B-FP8", "created_utc": "2026-09-12T19:55:22.904341+00:00"}}
