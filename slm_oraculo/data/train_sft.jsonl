_doc": "nr-05", "src_section": "5.9", "question": "Se o risco da empresa mudar, a gente tem que mudar a quantidade de gente da comissão de segurança na hora ou só na próxima eleição?", "facts": ["O redimensionamento da CIPA deve ser feito na próxima eleição", "A alteração do grau de risco do estabelecimento é o gatilho para essa mudança", "Não há redimensionamento imediato fora do ciclo eleitoral"], "coverage": 0.667, "seed_tag": 0, "gen_model": "Qwen/Qwen3.8-27B-FP8", "created_utc": "2026-09-12T20:02:55.934001+00:00"}}
