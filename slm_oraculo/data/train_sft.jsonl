src_chunk_id": 132, "src_doc": "nr-05", "src_section": "5.9", "question": "Sabe me dizer quantas pessoas tem que ter na CIPA aqui no canteiro de obras, dependendo do tamanho da firma?", "facts": ["A quantidade de membros titulares e suplentes da CIPA varia conforme o número de empregados na empresa.", "Para empresas de pequeno porte (1 a 19 empregados), a CIPA deve ter 1 efetivo e 1 suplente.", "Para empresas de médio porte (20 a 99 empregados), a CIPA deve ter 2 efetivos e 2 suplentes.", "Para empresas de grande porte (100 a 199 empregados), a CIPA deve ter 3 efetivos e 2 suplentes.", "O dimensionamento da CIPA na construção civil segue regras específicas do Anexo I da NR-05."], "coverage": 1.0, "seed_tag": 0, "gen_model": "Qwen/Qwen3.8-27B-FP8", "created_utc": "2026-09-12T19:55:21.979941+00:00"}}
