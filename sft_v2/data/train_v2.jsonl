ltou": true, "atribuiu_item_errado": false, "inventou_dado": false, "respondeu_o_possivel": false, "justificativa": "O modelo reconheceu corretamente que o contexto (NR-15) não responde à pergunta e indicou a norma correta (NR-18) para consulta, sem alucinar dados ou atribuir itens errados."}, "gen_model": "Qwen/Qwen3.8-27B-FP8", "wrong_chunk_id": 690, "wrong_doc": "nr-15", "created_utc": "2026-09-13T02:26:06.709949+00:00"}}
