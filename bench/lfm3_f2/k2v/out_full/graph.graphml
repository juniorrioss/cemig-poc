    </edge>
    <edge source="&quot;SEGURANÇA E SAÚDE NO TRABALHO&quot;" target="&quot;CAPACITAÇÃO&quot;">
      <data key="d4">chunk-a0493e5a610c1e30af5c60f7524c9e4b</data>
