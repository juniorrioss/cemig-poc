      <data key="d6">13</data>
    </edge>
    <edge source="&quot;SOBRECORRENTE&quot;" target="&quot;DISPOSITIVOS DE PROTEÇÃO&quot;">
      <data key="d4">chunk-47da6ea501f7dcd04f239daeda449a02</data>
