      <data key="d4">chunk-8256f00c2800357558f3e2c0d46b5d01</data>
      <data key="d5">"As normas de estabilização se aplicam à estocagem vertical de peças."</data>
      <data key="d6">19</data>
    </edge>
    <edge source="&quot;FIXAÇÃO E ESTABILIZAÇÃO TEMPORÁRIA DE ELEMENTOS ESTRUTURAIS&quot;" target="&quot;CONJUNTO DE ELEMENTOS&quot;">
      <data key="d4">chunk-8256f00c2800357558f3e2c0d46b5d01</data>
