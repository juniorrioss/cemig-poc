      <data key="d3">29</data>
    </node>
    <node id="&quot;CANTEIROS DE OBRAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Locais de construção sujeitos a regras específicas de segurança elétrica e proteção atmosférica."&lt;SEP&gt;"Local de trabalho onde se aplica a regulamentação sobre a instalação, operação e manutenção de elevadores para transporte vertical."</data>
