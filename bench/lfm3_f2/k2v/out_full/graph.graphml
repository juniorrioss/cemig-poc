      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Método de movimentação proibido, onde a carga não é içada verticalmente, aumentando o risco de queda ou instabilidade."</data>
      <data key="d2">chunk-7c19301d113ec019bab895c6c2e358ef</data>
      <data key="d3">32</data>
    </node>
    <node id="&quot;INSPEÇÃO DO SISTEMA HIDRÁULICO&quot;">
      <data key="d0">"EVENT"</data>
