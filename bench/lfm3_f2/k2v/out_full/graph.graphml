      <data key="d6">23</data>
    </edge>
    <edge source="&quot;EXTENSÃO MÁXIMA DE SETE METROS&quot;" target="&quot;ESCADAS DE MÃO&quot;">
      <data key="d4">chunk-59befa38d15567b8d7bcc3b001ac5bd3</data>
