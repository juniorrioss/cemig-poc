      <data key="d4">chunk-71c8ca74b83532683a7a57904153edda</data>
      <data key="d5">"Os exercícios simulados devem ser realizados de acordo com os cenários de emergência previamente mapeados."</data>
      <data key="d6">28</data>
    </edge>
