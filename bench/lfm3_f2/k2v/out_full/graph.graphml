      <data key="d6">20</data>
    </edge>
    <edge source="&quot;INDIVÍDUO OCUPACIONALMENTE EXPOSTO (IOE)&quot;" target="&quot;EXPOSIÇÃO OCUPACIONAL&quot;">
      <data key="d4">chunk-da5936a71a74343d6130e3c767256974</data>
