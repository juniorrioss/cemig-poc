      <data key="d6">30</data>
    </edge>
    <edge source="&quot;INCÊNDIO&quot;" target="&quot;TRABALHO A QUENTE&quot;">
      <data key="d4">chunk-d7f3fe8f8bfb9a820642da6555684412</data>
