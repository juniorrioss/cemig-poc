      <data key="d4">chunk-461b0578830e92eea6081cabfa2c7404</data>
      <data key="d5">"A bacia sanitária sifonada é um componente obrigatório da instalação sanitária."</data>
      <data key="d6">21</data>
    </edge>
    <edge source="&quot;SISTEMA DE TESTE&quot;" target="&quot;VÁLVULA DE SEGURANÇA&quot;">
      <data key="d4">chunk-8256f00c2800357558f3e2c0d46b5d01</data>
