      <data key="d6">34</data>
    </edge>
    <edge source="&quot;ANDAIME SIMPLESMENTE APOIADO&quot;" target="&quot;ESTRADO&quot;">
      <data key="d4">chunk-31723b05ed7f3abc65c5959c61472c4a</data>
      <data key="d5">"O andaime simplesmente apoiado é caracterizado pelo modo como seu estrado está apoiado."</data>
