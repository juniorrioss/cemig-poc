    <node id="&quot;COMPRIMENTO DO EQUIPAMENTO&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Extensão do sistema de retenção (cinto, corda) que detém o trabalhador em caso de queda."</data>
      <data key="d2">chunk-da5936a71a74343d6130e3c767256974</data>
      <data key="d3">29</data>
    </node>
    <node id="&quot;CIRCUITOS DE ALTA TENSÃO&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Linhas elétricas que operam em níveis de voltagem elevados, exigindo instalação separada de outras tensões."</data>
      <data key="d2">chunk-9fcca385fcdfc2bf69eb2e54c234a970</data>
      <data key="d3">31</data>
    </node>
    <node id="&quot;CARGAS COM PESO DESCONHECIDO&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Situação proibida onde a movimentação ocorre sem a determinação prévia do peso da carga, representando risco de sobrecarga."</data>
      <data key="d2">chunk-7c19301d113ec019bab895c6c2e358ef</data>
      <data key="d3">33</data>
    </node>
    <node id="&quot;DESMONTAGEM DE GRUAS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Processo de remoção do equipamento, sujeito às mesmas prescrições restritivas de segurança da montagem."</data>
      <data key="d2">chunk-de72701d9a6338255c6594fcfabb4d3c</data>
      <data key="d3">30</data>
    </node>
    <node id="&quot;LIMITADOR DE CARGA OU DE MOMENTO&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Dispositivo de segurança que atua automaticamente para impedir sobrecargas ou momentos excedentes no equipamento, acionando alarmes."</data>
      <data key="d2">chunk-3eac10d0f56e304067eea1b96ec59c97</data>
      <data key="d3">33</data>
    </node>
    <node id="&quot;MATERIAL PARA LAVAGEM E ENXUGO DAS MÃOS&quot;">
      <data key="d0">"ARTIFICIAL"</data>
      <data key="d1">"Insumos de higiene pessoal obrigatórios nas instalações sanitárias, devendo ser individuais."</data>
      <data key="d2">chunk-461b0578830e92eea6081cabfa2c7404</data>
      <data key="d3">26</data>
    </node>
    <node id="&quot;TRILHOS SUSPENSOS&quot;">
      <data key="d0">"ARTIFICIAL"</data>
