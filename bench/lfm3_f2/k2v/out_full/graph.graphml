      <data key="d6">29</data>
    </edge>
    <edge source="&quot;CABOS DE AÇO DE TRAÇÃO&quot;" target="&quot;EMENDAS&quot;">
      <data key="d4">chunk-3ad39a2fc22a6c8914aa4ba8440ccca4</data>
