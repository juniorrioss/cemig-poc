      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Prática de segurança obrigatória que impede a coexistência de materiais e pessoas no mesmo espaço da cabine."</data>
      <data key="d2">chunk-11f7df212717dd8ee2d97d84f42a97ad</data>
      <data key="d3">28</data>
    </node>
    <node id="&quot;CINTAS SINTÉTICAS&quot;">
      <data key="d0">"ARTIFICIAL"</data>
      <data key="d1">"Acessório de içamento feito de fibra sintética, que deve passar por inspeções visuais para garantir conformidade e segurança no uso."</data>
      <data key="d2">chunk-3ad39a2fc22a6c8914aa4ba8440ccca4</data>
      <data key="d3">35</data>
    </node>
