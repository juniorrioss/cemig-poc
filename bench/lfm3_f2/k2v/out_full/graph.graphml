      <data key="d6">25</data>
    </edge>
    <edge source="&quot;INDIVÍDUO OCUPACIONALMENTE EXPOSTO (IOE)&quot;" target="&quot;PORTARIA MTB Nº 790&quot;">
      <data key="d4">chunk-da5936a71a74343d6130e3c767256974</data>
