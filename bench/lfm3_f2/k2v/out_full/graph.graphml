      <data key="d4">chunk-31723b05ed7f3abc65c5959c61472c4a</data>
      <data key="d5">"O procedimento deve descrever as medidas de proteção coletiva e instruções de uso dos EPCs."</data>
      <data key="d6">27</data>
    </edge>
