      <data key="d6">19</data>
    </edge>
    <edge source="&quot;FATOR DE QUEDA&quot;" target="&quot;COMPRIMENTO DO EQUIPAMENTO&quot;">
      <data key="d4">chunk-da5936a71a74343d6130e3c767256974</data>
