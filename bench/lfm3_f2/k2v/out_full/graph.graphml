      <data key="d4">chunk-8256f00c2800357558f3e2c0d46b5d01</data>
      <data key="d5">"O cabo de segurança é adotado especificamente para evitar o fenômeno de chicoteamento."</data>
      <data key="d6">23</data>
    </edge>
    <edge source="&quot;ETAPAS DE OBRA&quot;" target="&quot;INDÚSTRIA DA CONSTRUÇÃO&quot;">
      <data key="d4">chunk-a0493e5a610c1e30af5c60f7524c9e4b</data>
