      <data key="d6">29</data>
    </edge>
    <edge source="&quot;MÁQUINAS AUTOPROPELIDAS&quot;" target="&quot;REDES ELÉTRICAS&quot;">
      <data key="d4">chunk-81eec1f6ee4405401ff40539cf37d1e6</data>
