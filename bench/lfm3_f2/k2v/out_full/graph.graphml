      <data key="d2">chunk-de72701d9a6338255c6594fcfabb4d3c</data>
      <data key="d3">32</data>
    </node>
    <node id="&quot;POLIAS&quot;">
      <data key="d0">"ARTIFICIAL"</data>
      <data key="d1">"Componente mecânico de içamento que requer identificação visual de danos durante a inspeção de segurança."&lt;SEP&gt;"Componentes mecânicos do sistema de tração do guindaste, que devem possuir dispositivos para impedir o escape dos cabos."&lt;SEP&gt;"Componentes mecânicos dos sistemas de elevação onde são instalados dispositivos para impedir o escape acidental dos cabos de aço."&lt;SEP&gt;"Componentes mecânicos utilizados no moitão para direcionar e tensionar o cabo de içamento."</data>
      <data key="d2">chunk-6b53e002d3295871a52b86e59f30957b&lt;SEP&gt;chunk-3eac10d0f56e304067eea1b96ec59c97&lt;SEP&gt;chunk-3ad39a2fc22a6c8914aa4ba8440ccca4&lt;SEP&gt;chunk-80ef69391dd4e50ae486de13fe53bc42</data>
      <data key="d3">117</data>
    </node>
    <node id="&quot;CONDIÇÕES MÍNIMAS DE CONFORTO E HIGIENE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Padrão qualitativo obrigatório para os locais de refeição, garantindo dignidade e saúde aos trabalhadores."</data>
      <data key="d2">chunk-461b0578830e92eea6081cabfa2c7404</data>
      <data key="d3">29</data>
    </node>
    <node id="&quot;CORDAS&quot;">
      <data key="d0">"ARTIFICIAL"</data>
      <data key="d1">"Dispositivo de segurança conectado a pontos de ancoragem para proteção contra quedas."</data>
      <data key="d2">chunk-6b53e002d3295871a52b86e59f30957b</data>
      <data key="d3">21</data>
    </node>
    <node id="&quot;MEDIDAS ALTERNATIVAS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ações de segurança complementares definidas na APR para substituir a EPC quando esta não é tecnicamente viável."</data>
      <data key="d2">chunk-8256f00c2800357558f3e2c0d46b5d01</data>
      <data key="d3">27</data>
    </node>
