      <data key="d6">31</data>
    </edge>
    <edge source="&quot;SISTEMA ELÉTRICO DE POTÊNCIA&quot;" target="&quot;TRABALHOS EM PROXIMIDADE DO SISTEMA ELÉTRICO DE POTÊNCIA&quot;">
      <data key="d4">chunk-58fd45d2ee14671afd511b654fd72573</data>
