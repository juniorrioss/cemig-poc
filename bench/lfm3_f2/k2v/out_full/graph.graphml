      <data key="d4">chunk-49ef538556a551b7484cd4f959f104da</data>
      <data key="d5">"A instalação sanitária deve estar localizada a no máximo 50 metros do posto de trabalho do operador."</data>
      <data key="d6">24</data>
    </edge>
