      <data key="d3">34</data>
    </node>
    <node id="&quot;PEÇA&quot;">
      <data key="d0">"ARTIFICIAL"</data>
      <data key="d1">"Componente físico que possui uma área vélica exposta ao vento."&lt;SEP&gt;"Componente industrial sujeito ao teste de estanqueidade."</data>
