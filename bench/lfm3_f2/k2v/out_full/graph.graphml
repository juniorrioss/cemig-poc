      <data key="d3">34</data>
    </node>
    <node id="&quot;MEDIDAS DE PROTEÇÃO COLETIVA (MPC)&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Métodos de controle de riscos que protegem todos os trabalhadores simultaneamente, sendo o padrão que pode ser substituído por soluções alternativas."</data>
