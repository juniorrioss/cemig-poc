      <data key="d4">chunk-28f3dbec47aed130afea6282dbc514ba</data>
      <data key="d5">"O armário serve para isolar a vestimenta de trabalho das roupas de uso comum."</data>
      <data key="d6">23</data>
    </edge>
    <edge source="&quot;ARMÁRIO INDIVIDUAL DUPLO&quot;" target="&quot;ROUPA DE USO COMUM&quot;">
      <data key="d4">chunk-28f3dbec47aed130afea6282dbc514ba</data>
