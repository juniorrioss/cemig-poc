      <data key="d4">chunk-bc556663e5d61db34218f36477303b44</data>
      <data key="d5">"O locador também é responsável por indicar os esforços na estrutura e apoios das plataformas."</data>
      <data key="d6">26</data>
    </edge>
    <edge source="&quot;COPOS DESCARTÁVEIS&quot;" target="&quot;RECIPIENTE PORTA-COPOS&quot;">
      <data key="d4">chunk-777529d0ca6ad0353d174f0c0945acab</data>
