      <data key="d6">20</data>
    </edge>
    <edge source="&quot;PROTENSÃO&quot;" target="&quot;PERMANÊNCIA DE TRABALHADORES ATRÁS OU SOBRE DISPOSITIVOS DE PROTENSÃO&quot;">
      <data key="d4">chunk-0f6aac9b4d8e9449b9eed627c3cd47ce</data>
      <data key="d5">"É proibida a permanência de trabalhadores nessas posições durante a protensão."</data>
      <data key="d6">22</data>
    </edge>
