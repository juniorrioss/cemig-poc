      <data key="d6">31</data>
    </edge>
    <edge source="&quot;RISCOS POTENCIAIS INERENTES AO TRABALHO HIPERBÁRICO&quot;" target="&quot;ENCARREGADO DE AR COMPRIMIDO&quot;">
      <data key="d4">chunk-3ad39a2fc22a6c8914aa4ba8440ccca4</data>
      <data key="d5">"Deve estar ciente dos riscos do trabalho hiperbárico."</data>
      <data key="d6">18</data>
    </edge>
    <edge source="&quot;EPC&quot;" target="&quot;SOLDA ELÉTRICA&quot;">
      <data key="d4">chunk-2d1210959aca2e55706f5f576974cfb6</data>
