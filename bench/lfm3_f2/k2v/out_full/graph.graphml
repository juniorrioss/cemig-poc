      <data key="d6">18</data>
    </edge>
    <edge source="&quot;ACESSO POR CORDA&quot;" target="&quot;ESCALADA INDUSTRIAL&quot;">
      <data key="d4">chunk-0110767f6db591ee0b38d305f6ff2756</data>
      <data key="d5">"O acesso por corda é executado utilizando procedimentos técnicos de escalada industrial."</data>
      <data key="d6">19</data>
    </edge>
    <edge source="&quot;ACESSO POR CORDA&quot;" target="&quot;NORMA TÉCNICA NACIONAL&quot;">
      <data key="d4">chunk-0110767f6db591ee0b38d305f6ff2756</data>
      <data key="d5">"As atividades de acesso por corda devem seguir as diretrizes estabelecidas em normas técnicas nacionais."</data>
      <data key="d6">28</data>
    </edge>
    <edge source="&quot;ACESSO POR CORDA&quot;" target="&quot;EQUIPE DE TRABALHO&quot;">
      <data key="d4">chunk-0110767f6db591ee0b38d305f6ff2756</data>
      <data key="d5">"A equipe de trabalho é a entidade responsável pela execução segura das atividades de acesso por corda."</data>
      <data key="d6">24</data>
    </edge>
    <edge source="&quot;ACESSO POR CORDA&quot;" target="&quot;PLANO DE AUTORRESGATE E RESGATE&quot;">
      <data key="d4">chunk-0110767f6db591ee0b38d305f6ff2756</data>
      <data key="d5">"Um plano de resgate é obrigatório para cada local onde se executa trabalho de acesso por corda."</data>
      <data key="d6">23</data>
    </edge>
    <edge source="&quot;ACESSO POR CORDA&quot;" target="&quot;PONTOS DE ANCORAGEM&quot;">
      <data key="d4">chunk-0110767f6db591ee0b38d305f6ff2756</data>
      <data key="d5">"Durante o acesso por corda, o trabalhador deve permanecer conectado a pelo menos dois pontos de ancoragem."</data>
      <data key="d6">27</data>
    </edge>
    <edge source="&quot;ACESSO POR CORDA&quot;" target="&quot;EQUIPAMENTOS E CORDAS CERTIFICADOS&quot;">
      <data key="d4">chunk-0110767f6db591ee0b38d305f6ff2756</data>
      <data key="d5">"Somente equipamentos e cordas certificados podem ser utilizados para garantir a segurança no acesso por corda."</data>
      <data key="d6">26</data>
    </edge>
    <edge source="&quot;ACESSO POR CORDA&quot;" target="&quot;CERTIFICAÇÃO DA EMPRESA&quot;">
      <data key="d4">chunk-0110767f6db591ee0b38d305f6ff2756</data>
      <data key="d5">"A empresa responsável pelo serviço de acesso por corda deve possuir certificação válida."</data>
      <data key="d6">19</data>
    </edge>
    <edge source="&quot;ACESSO POR CORDA&quot;" target="&quot;CONDIÇÕES METEOROLÓGICAS ADVERSAS&quot;">
      <data key="d4">chunk-0110767f6db591ee0b38d305f6ff2756</data>
      <data key="d5">"O trabalho deve ser interrompido em caso de condições meteorológicas adversas."</data>
      <data key="d6">20</data>
    </edge>
