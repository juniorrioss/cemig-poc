      <data key="d6">37</data>
    </edge>
    <edge source="&quot;NORMA REGULAMENTADORA 34&quot;" target="&quot;ESTRUTURA FLUTUANTE&quot;">
      <data key="d4">chunk-af302f9355e316c7b9d518b53d5e0e38</data>
