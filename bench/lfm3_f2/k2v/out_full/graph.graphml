      <data key="d6">21</data>
    </edge>
    <edge source="&quot;FATOR DE QUEDA&quot;" target="&quot;TRABALHADOR&quot;">
      <data key="d4">chunk-da5936a71a74343d6130e3c767256974</data>
      <data key="d5">"O fator de queda é calculado com base na trajetória do trabalhador em caso de queda."</data>
      <data key="d6">24</data>
    </edge>
