      <data key="d6">31</data>
    </edge>
    <edge source="&quot;ANEXO II - CABOS DE AÇO E DE FIBRA SINTÉTICA&quot;" target="&quot;CABOS DE AÇO&quot;">
      <data key="d4">chunk-3ad39a2fc22a6c8914aa4ba8440ccca4</data>
      <data key="d5">"O Anexo II trata especificamente das normas para cabos de aço."</data>
