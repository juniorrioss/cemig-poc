      <data key="d6">32</data>
    </edge>
    <edge source="&quot;DESLOCAMENTO MÁXIMO DE 100 METROS HORIZONTAL&quot;" target="&quot;POSTO DE TRABALHO&quot;">
      <data key="d4">chunk-461b0578830e92eea6081cabfa2c7404</data>
