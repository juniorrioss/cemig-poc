      <data key="d6">22</data>
    </edge>
    <edge source="&quot;ANDAIMES E PLATAFORMAS DE TRABALHO&quot;" target="&quot;INDÚSTRIA DA CONSTRUÇÃO&quot;">
      <data key="d4">chunk-a0493e5a610c1e30af5c60f7524c9e4b</data>
      <data key="d5">"Andaimes são equipamentos essenciais e comuns na indústria da construção, sendo alvo de regulamentação específica na norma."</data>
      <data key="d6">34</data>
    </edge>
    <edge source="&quot;BACIA SANITÁRIA SIFONADA&quot;" target="&quot;ASSENTO COM TAMPO&quot;">
      <data key="d4">chunk-461b0578830e92eea6081cabfa2c7404</data>
      <data key="d5">"A bacia sanitária deve ser dotada de assento com tampo como requisito obrigatório."</data>
