      <data key="d6">24</data>
    </edge>
    <edge source="&quot;PAINÉIS&quot;" target="&quot;POSIÇÃO HORIZONTAL&quot;">
      <data key="d4">chunk-3ba2773d9f660536f70f2b3fcd5161e9</data>
      <data key="d5">"Painéis na posição horizontal seguem critérios de fixação diferentes daqueles na posição vertical."</data>
      <data key="d6">22</data>
    </edge>
    <edge source="&quot;PAINÉIS&quot;" target="&quot;FIXAÇÃO TEMPORÁRIA&quot;">
      <data key="d4">chunk-3ba2773d9f660536f70f2b3fcd5161e9</data>
      <data key="d5">"Painéis seguem regras de fixação temporária baseadas em sua orientação e método de apoio."</data>
      <data key="d6">25</data>
    </edge>
    <edge source="&quot;EMENDAS SUBMERSAS&quot;" target="&quot;FITA DE AUTOFUSÃO&quot;">
      <data key="d4">chunk-0dc9d148efe9a2559b7beaa15d4eb102</data>
