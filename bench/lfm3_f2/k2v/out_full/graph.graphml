      <data key="d6">27</data>
    </edge>
    <edge source="&quot;MÁQUINAS AUTOPROPELIDAS&quot;" target="&quot;CABINE CLIMATIZADA&quot;">
      <data key="d4">chunk-81eec1f6ee4405401ff40539cf37d1e6</data>
