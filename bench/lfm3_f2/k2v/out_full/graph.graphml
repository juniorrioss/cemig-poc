      <data key="d6">22</data>
    </edge>
    <edge source="&quot;FIXAÇÃO E ESTABILIZAÇÃO TEMPORÁRIA DE ELEMENTOS ESTRUTURAIS&quot;" target="&quot;NR-34&quot;">
      <data key="d4">chunk-c1b9ab0eb29b76caf7836ed396330ed8</data>
