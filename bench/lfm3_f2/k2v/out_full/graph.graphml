      <data key="d4">chunk-b27bda215a442c90cb021c21b98db115</data>
      <data key="d5">"As instalações destinam-se à recuperação e observação dos trabalhadores."&lt;SEP&gt;"As instalações destinam-se às fases de recuperação e observação dos trabalhadores."</data>
      <data key="d6">43</data>
    </edge>
