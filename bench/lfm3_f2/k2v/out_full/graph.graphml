      <data key="d6">25</data>
    </edge>
    <edge source="&quot;SEGURANÇA DO TRABALHADOR&quot;" target="&quot;TRABALHADOR&quot;">
      <data key="d4">chunk-7ba30f0a53c36f36a6dd512887c3a223</data>
      <data key="d5">"Todas as normas descritas têm como objetivo final garantir a integridade física e a segurança do trabalhador."</data>
      <data key="d6">30</data>
    </edge>
    <edge source="&quot;INDIVÍDUO OCUPACIONALMENTE EXPOSTO (IOE)&quot;" target="&quot;RADIAÇÃO IONIZANTE&quot;">
      <data key="d4">chunk-da5936a71a74343d6130e3c767256974</data>
