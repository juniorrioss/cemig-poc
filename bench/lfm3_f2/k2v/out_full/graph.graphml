      <data key="d6">22</data>
    </edge>
    <edge source="&quot;SISTEMA ELÉTRICO DE POTÊNCIA&quot;" target="&quot;SEGURANÇA EM PROJETOS&quot;">
      <data key="d4">chunk-58fd45d2ee14671afd511b654fd72573</data>
