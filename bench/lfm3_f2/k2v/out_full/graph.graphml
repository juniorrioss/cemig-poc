      <data key="d4">chunk-3ad39a2fc22a6c8914aa4ba8440ccca4</data>
      <data key="d5">"Cabos de tração não podem ter pernas quebradas."</data>
      <data key="d6">15</data>
    </edge>
    <edge source="&quot;LOCADOR&quot;" target="&quot;LISTA DE VERIFICAÇÃO&quot;">
