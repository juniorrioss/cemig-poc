{"text": "Já chega, gente! Não me dá pra continuar aqui, a gente precisa de umas férias, já.", "primary": "nr-12", "gold": "nr-12", "kind": "diffgen", "prompt_kind": "diff:nr-12:desabafo", "generator": "google_gemma-3-1b-it-Q4_K_M.gguf"}
