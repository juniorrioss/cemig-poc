{"text": "Mano, tá um inferno aqui. Que calor, né? Quero que o vento vá embora.", "primary": "nr-15", "gold": "nr-15", "kind": "diffgen", "prompt_kind": "diff:nr-15:truncada", "generator": "google_gemma-3-1b-it-Q4_K_M.gguf"}
